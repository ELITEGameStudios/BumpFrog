  m_Script: {fileID: 11500000, guid: ca46c4d42974b0d4b8dd731949bd1376, type: 3}
  m_Name: StayFriendsEnding
  m_EditorClassIdentifier: 
  lines:
  - characterName: Player
    dialogueText: I think I see you only as a friend
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 21300000, guid: 1bc073046b3714041945298f4ba28164, type: 3}
    playerPosition: 3
    rivalEmoticon: {fileID: 0}
    rivalPosition: 0
    hasChoices: 0
    choices: []
  - characterName: Rival
    dialogueText: I understand, thank you for being honest with me. We can still
      be friends I hope
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 0}
    playerPosition: 3
    rivalEmoticon: {fileID: 21300000, guid: dafa8f4e5cf0de643b10ce4555a4440c, type: 3}
    rivalPosition: 4
    hasChoices: 0
    choices: []
  - characterName: Player
    dialogueText: Of course, I look forward to our next match together.
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 21300000, guid: 1a61bb50f218c1541876c82d272ab253, type: 3}
    playerPosition: 4
    rivalEmoticon: {fileID: 0}
    rivalPosition: 4
    hasChoices: 0
    choices: []
  - characterName: Narrator
    dialogueText: (You both accepted how the other felt and was able to move on past
      it and not let it effect your friendship, you remained close friends for the
      rest of your lives.)
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 0}
    playerPosition: 4
    rivalEmoticon: {fileID: 0}
    rivalPosition: 4
    hasChoices: 0
    choices: []
  - characterName: Narrator
    dialogueText: 'Route: Best Friends Ending'
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 0}
    playerPosition: 4
    rivalEmoticon: {fileID: 0}
    rivalPosition: 4
