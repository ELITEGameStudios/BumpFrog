    playerEmoticon: {fileID: 0}
    playerPosition: 0
    rivalEmoticon: {fileID: 0}
    rivalPosition: 4
    hasChoices: 0
    choices: []
  - characterName: Rival
    dialogueText: So?! What does it look like?! You said you couldn't make it and...
      and this is how I find you...? With the frog! Tell me the truth!
    soundEffect: {fileID: 0}
    playerEmoticon: {fileID: 0}
    playerPosition: 0
